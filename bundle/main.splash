// 本地规则整理；没有在线模型、邮箱访问或消息发送
let draft_ready = false
let source_snapshot = ""
fn restore(){
    try {
    ui.draft_area.set_visible(false)
    if fs.exists("draft-state.json") && fs.exists("user-draft.txt") {
        let state = fs.read("draft-state.json").parse_json()
        if state != nil && state.source != nil && state.draft != nil {
            if state.draft != "" && fs.read("user-draft.txt") == state.draft {
                ui.source_input.set_text(state.source)
                ui.draft_input.set_text(state.draft)
                source_snapshot = state.source
                ui.draft_area.set_visible(true)
                draft_ready = true
                ui.status_label.set_text("已恢复上次核验的草稿，尚未发送")
                return
            }
        }
        ui.status_label.set_text("保存状态不一致，请重新整理原文")
    }
    } catch { ui.status_label.set_text("保存状态无法读取，请重新整理原文") }
}
fn organize(){
    draft_ready = false
    ui.draft_area.set_visible(false)
    let text = ui.source_input.text()
    if text.trim() == "" {
        ui.status_label.set_text("请输入原文；空输入不会保存")
        return
    }
    let mail = regex("邮件|草稿|mail", "i").test(text)
    let unfinished = regex("未完成|没写完|还没|只写|写了一半|未发送|没发|待完善").test(text)
    if !regex("邮件草稿").test(text) && !(mail && unfinished) {
        ui.status_label.set_text("无需行动：未发现未完成的邮件草稿")
        return
    }
    source_snapshot = text
    ui.draft_input.set_text(text + "\n\n谢谢。")
    ui.draft_area.set_visible(true)
    draft_ready = true
    ui.status_label.set_text("来源：你提供的原文；下一步：编辑后确认保存")
}
fn confirm_save(){
    try {
    if !draft_ready {
        ui.status_label.set_text("请先整理草稿；取消或修改原文后需重新整理")
        return
    }
    let draft = ui.draft_input.text()
    if draft.trim() == "" {
        ui.status_label.set_text("草稿为空，不会保存")
        return
    }
    fs.write("user-draft.txt", draft)
    if !fs.exists("user-draft.txt") || fs.read("user-draft.txt") != draft {
        ui.status_label.set_text("保存失败：结果无法读回核验")
        return
    }
    let state = {source: source_snapshot, draft: draft}.to_json()
    fs.write("draft-state.json", state)
    if !fs.exists("draft-state.json") || fs.read("draft-state.json") != state {
        ui.status_label.set_text("草稿已写入，但恢复状态未核验成功")
        return
    }
    ui.status_label.set_text("已保存并核验，尚未发送")
    } catch { ui.status_label.set_text("保存失败：文件写入或读回未完成，请重试") }
}
fn cancel(){
    draft_ready = false
    ui.draft_area.set_visible(false)
    ui.draft_input.set_text("")
    ui.status_label.set_text("已取消；没有保存本次编辑")
}
fn clear_data(){
    try {
    if fs.exists("user-draft.txt") { fs.remove("user-draft.txt") }
    if fs.exists("draft-state.json") { fs.remove("draft-state.json") }
    if fs.exists("user-draft.txt") || fs.exists("draft-state.json") {
        ui.status_label.set_text("清除失败；已有文件仍保留")
        return
    }
    ui.source_input.set_text("")
    ui.draft_input.set_text("")
    source_snapshot = ""
    draft_ready = false
    ui.draft_area.set_visible(false)
    ui.status_label.set_text("本地数据已清除")
    } catch { ui.status_label.set_text("清除失败；请检查本地存储") }
}
start_timeout(0.15, || restore())
SolidView{width: Fill height: Fill flow: Down padding: 16 spacing: 10 draw_bg.color: #xffffff
    Label{text: "无提醒 Agent" draw_text.text_style.font_size: 25 draw_text.color: #x1c1c1e}
    Label{text: "本地规则整理 · 不调用在线模型" draw_text.text_style.font_size: 13 draw_text.color: #x666666}
    Label{text: "仅处理你提供的文本，不读取或发送邮件" draw_text.text_style.font_size: 12 draw_text.color: #x666666}
    Label{text: "提供未完成邮件的原文" draw_text.text_style.font_size: 14 draw_text.color: #x1c1c1e}
    source_input := TextInput{width: Fill height: 110 is_multiline: true draw_text.color: #x1c1c1e text: ""
        on_change: |text| { draft_ready = false }
    }
    ButtonFlat{text: "整理草稿" width: Fill height: 42 on_click: || organize() draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff} draw_bg +: {color: #x007aff color_hover: #x006be0 color_down: #x005bcc border_radius: 6.0}}
    status_label := Label{text: "准备就绪，请提供原文" width: Fill height: Fit draw_text.text_style.font_size: 12 draw_text.color: #x1c1c1e}
    draft_area := View{width: Fill height: Fit flow: Down spacing: 8 visible: false
        Label{text: "可编辑草稿（保留原文，添加中性结尾）" draw_text.text_style.font_size: 12 draw_text.color: #x1c1c1e}
        draft_input := TextInput{width: Fill height: 140 is_multiline: true draw_text.color: #x1c1c1e text: ""}
    }
    ButtonFlat{text: "确认保存" width: Fill height: 42 on_click: || confirm_save() draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff} draw_bg +: {color: #x007aff color_hover: #x006be0 color_down: #x005bcc border_radius: 6.0}}
    ButtonFlat{text: "取消" width: Fill height: 36 on_click: || cancel() draw_text +: {color: #x1c1c1e color_hover: #x1c1c1e color_down: #x1c1c1e}}
    ButtonFlat{text: "清除本地数据" width: Fill height: 36 on_click: || clear_data() draw_text +: {color: #x1c1c1e color_hover: #x1c1c1e color_down: #x1c1c1e}}
    Label{text: "只保存到本应用。你决定是否行动，我们不催促。" draw_text.text_style.font_size: 12 draw_text.color: #x666666}
}
